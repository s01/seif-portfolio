rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "saifmohsen65@gmail.com";
    }

    // ✅ Public read: projects
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ✅ Public read: public settings docs only
    match /settings/{docId} {
      allow read: if docId in ['portfolio', 'skills', 'timeline', 'certifications'];
      allow write: if isAdmin();
    }

    // ✅ Public read + admin write: certifications_v2
    match /certifications_v2/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🔒 Analytics: admin only
    match /analytics_events/{doc=**} {
      allow read, write: if isAdmin();
    }

    // 🔥 Lock sensitive admin doc
    match /settings/admin {
      allow read, write: if false;
    }

    // ❌ Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
